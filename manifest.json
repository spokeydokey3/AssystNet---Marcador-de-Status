{
  "manifest_version": 3,
  "name": "AssystNet - Marcador de Status",
  "version": "3.0",
  "description": "Marcadores totalmente customiz\u00e1veis, edi\u00e7\u00e3o completa de tags e cria\u00e7\u00e3o inline na tabela.",
  "browser_specific_settings": {
    "gecko": {
      "id": "assyst-status-tagger@tjce.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://cati.tj.ce.gov.br/assystnet/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AssystNet - Gerenciar Tags"
  },
  "content_scripts": [
    {
      "matches": [
        "http://cati.tj.ce.gov.br/assystnet/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}